{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "deployment-provider-adapter",
  "projectType": "library",
  "sourceRoot": "packages/deployment-provider-adapter/src",
  "implicitDependencies": ["contracts", "evidence-kernel"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/deployment-provider-adapter"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "packages/deployment-provider-adapter"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "cwd": "packages/deployment-provider-adapter"
      }
    }
  }
}
