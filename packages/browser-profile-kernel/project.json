{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "browser-profile-kernel",
  "projectType": "library",
  "sourceRoot": "packages/browser-profile-kernel/src",
  "implicitDependencies": ["contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/browser-profile-kernel"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "packages/browser-profile-kernel"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "cwd": "packages/browser-profile-kernel"
      }
    }
  }
}
