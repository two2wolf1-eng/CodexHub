{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "skill-registry",
  "projectType": "library",
  "sourceRoot": "packages/skill-registry/src",
  "implicitDependencies": ["contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/skill-registry"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "packages/skill-registry"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "cwd": "packages/skill-registry"
      }
    }
  }
}
