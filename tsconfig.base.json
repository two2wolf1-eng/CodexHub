      "@codexhub/otel-adapter": ["packages/otel-adapter/src/index.ts"],
      "@codexhub/orchestrator-kernel": ["packages/orchestrator-kernel/src/index.ts"],
      "@codexhub/playwright-observer-adapter": ["packages/playwright-observer-adapter/src/index.ts"],
