      "@codexhub/contracts": ["packages/contracts/src/index.ts"],
      "@codexhub/electron-cdp-adapter": ["packages/electron-cdp-adapter/src/index.ts"],
      "@codexhub/electron-cdp-kernel": ["packages/electron-cdp-kernel/src/index.ts"],
      "@codexhub/evidence-kernel": ["packages/evidence-kernel/src/index.ts"],
      "@codexhub/governance-projection-kernel": [
        "packages/governance-projection-kernel/src/index.ts"
      ],
      "@codexhub/mcp-tool-contracts": ["packages/mcp-tool-contracts/src/index.ts"],
