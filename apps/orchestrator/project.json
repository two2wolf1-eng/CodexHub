{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "orchestrator",
  "projectType": "application",
  "sourceRoot": "apps/orchestrator/src",
  "implicitDependencies": ["contracts", "orchestrator-kernel"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/orchestrator/tsconfig.json",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "apps/orchestrator"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "cwd": "apps/orchestrator"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/orchestrator/src/main.ts",
        "cwd": "."
      }
    }
  }
}
