{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "supervisor",
  "projectType": "application",
  "sourceRoot": "apps/supervisor/src",
  "implicitDependencies": [
    "contracts",
    "observer-kernel",
    "workflow-kernel",
    "orchestrator-kernel",
    "store-core",
    "store-sqlite"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/supervisor/tsconfig.json",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "apps/supervisor"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --config ../../vitest.config.ts",
        "cwd": "apps/supervisor"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/supervisor/src/main.ts",
        "cwd": "."
      }
    }
  }
}
