{
  "name": "codexhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "nx": "nx",
    "codexhub": "tsx apps/cli/src/main.ts",
    "audit:boundaries": "tsx tools/audit-import-boundaries.ts",
    "audit:sqlite-isolation": "tsx tools/audit-sqlite-isolation.ts",
    "audit:no-live-automation": "tsx tools/audit-no-live-automation.ts",
    "scaffold:health": "tsx tools/scaffold-health.ts",
    "verify:foundation": "pnpm scaffold:health && pnpm audit:boundaries && pnpm audit:sqlite-isolation && pnpm audit:no-live-automation && pnpm nx run-many -t lint,test,build",
    "lint": "pnpm nx run-many -t lint",
    "test": "pnpm nx run-many -t test",
    "build": "pnpm nx run-many -t build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "commander": "^12.1.0",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "nx": "^20.3.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
